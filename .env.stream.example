# Cloudflare Stream Development Environment Variables
# これらの値は実際のCloudflareアカウントから取得する必要があります

# Cloudflare Account ID
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Cloudflare Stream API Token (Edit:Cloudflare Stream権限が必要)
CLOUDFLARE_STREAM_API_TOKEN=your_stream_api_token

# Cloudflare Stream Webhook Secret (32文字以上の安全な文字列)
CLOUDFLARE_STREAM_WEBHOOK_SECRET=your_webhook_secret_32_chars_or_more

