# Environment Example for BeatNexus
# Supabase 設定
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Service role key is only set in deployment secret store, not locally committed
# SUPABASE_SERVICE_ROLE_KEY=

# Resend API (メール配信)
RESEND_API_KEY=your-resend-api-key

# Stripe 設定（SuperTip機能）
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_CONNECT_CLIENT_ID=ca_your-connect-client-id
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# フロントエンドURL
FRONTEND_URL=http://localhost:3000

# 🛎️ Push Notification - VAPID Keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# 🎯 Feature Flags
VITE_ENABLE_SUPER_TIP=false

# 広告配信設定
VITE_ADS_DELIVERY_DISABLED=false
VITE_ADS_TRACKING_SUSPENDED=true

# Ads JWS signing secret (HS256). Rotate via deployment secret store.
AD_JWS_SECRET=change-me-dev

# (Optional) Future: REDIS_URL for external dedupe/cache
# REDIS_URL=
